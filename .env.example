# Port the website listens on
PORT=3000
# Where the database file (db.json) is kept. Mount a persistent disk here when hosting.
DATA_DIR=./data
# How many people may create an account (you + your friend)
MAX_USERS=2
# Recommended on a public URL: sign-up requires this code
INVITE_CODE=
# Optional: a private Solana RPC (Helius, QuickNode...) is far more reliable than the public one
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
